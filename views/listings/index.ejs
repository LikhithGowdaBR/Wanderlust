<% layout("/layouts/boilerplate") %>
  <body>
    <!-- <h3>All Listings</h3> -->
    <!-- <form method = "GET" action="/listings/new">
      <button>Create New Listing </button>
    </form> -->
  <style>
    #filters {
      display:flex;
      flex-wrap: wrap;
    }

    .filter {
      text-align: center;
      margin-right:2rem;
      margin-top:2rem;
      opacity:0.7;
    }

    .filter:hover{
      opacity:1;
      cursor:pointer;
    }

    .filter.active-filter {
      opacity:1;
      font-weight:700;
    }

    .filter p {
      font-size:0.8rem;  
    }

    .filter-link {
      color: inherit;
      text-decoration: none;
    }
  </style>
  
  <div id="filters">
    <a href="/listings" class="filter-link">
      <div class="filter <%= selectedCategory === 'All' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-list"></i></div>
        <p>All</p>
      </div>
    </a>
    <a href="/listings?category=Trending" class="filter-link">
      <div class="filter <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
    </a>
    <a href="/listings?category=Parks" class="filter-link">
      <div class="filter <%= selectedCategory === 'Parks' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Parks</p>
      </div>
    </a>
    <a href="/listings?category=Temple" class="filter-link">
      <div class="filter <%= selectedCategory === 'Temple' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-place-of-worship"></i></div>
        <p>Temple</p>
      </div>
    </a>
    <a href="/listings?category=Cafe" class="filter-link">
      <div class="filter <%= selectedCategory === 'Cafe' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mug-hot"></i></div>
        <p>Cafe</p>
      </div>
    </a>
    <a href="/listings?category=Restaurant" class="filter-link">
      <div class="filter <%= selectedCategory === 'Restaurant' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-utensils"></i></div>
        <p>Restaurant</p>
      </div>
    </a>
    <a href="/listings?category=Hotel" class="filter-link">
      <div class="filter <%= selectedCategory === 'Hotel' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-hotel"></i></div>
        <p>Hotel</p>
      </div>
    </a>
    <a href="/listings?category=Beach" class="filter-link">
      <div class="filter <%= selectedCategory === 'Beach' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
      </div>
    </a>
    <a href="/listings?category=Hills" class="filter-link">
      <div class="filter <%= selectedCategory === 'Hills' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Hills</p>
      </div>
    </a>
    <a href="/listings?category=Historical%20Place" class="filter-link">
      <div class="filter <%= selectedCategory === 'Historical Place' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-landmark"></i></div>
        <p>Historical Place</p>
      </div>
    </a>
    <a href="/listings?category=Trekking" class="filter-link">
      <div class="filter <%= selectedCategory === 'Trekking' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-person-hiking"></i></div>
        <p>Trekking</p>
      </div>
    </a>
    <a href="/listings?category=Waterfall%2FLake" class="filter-link">
      <div class="filter <%= selectedCategory === 'Waterfall/Lake' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Waterfall/Lake</p>
      </div>
    </a>
    <a href="/listings?category=Other" class="filter-link">
      <div class="filter <%= selectedCategory === 'Other' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-ellipsis"></i></div>
        <p>Other</p>
      </div>
    </a>
  </div>
  <div class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-1 mt-3">     <!-- 3 images in row -->
    <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %></b>
          <br>
          <span class="badge bg-dark"><%= listing.category %></span>
          <br>
          &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
        </p>
      </div>
    </div>
    </a>
    <% } %> 
  </div>



  